# Publish the application, not the personal research workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/Info.plist
!/build.sh
!/Sources/
!/Tests/
!/tools/
!/docs/
!/Assets/
!/content/
!/.github/

/tools/*
!/tools/check.sh
/docs/*
!/docs/development.md
!/docs/usage.md
/Assets/*
!/Assets/Brand/
/Assets/Brand/*
!/Assets/Brand/Logo.png
!/Assets/Brand/AppIcon.icns
/content/*
!/content/public/
!/content/reader-vendor/

.DS_Store
__pycache__/
*.pyc
.env
.env.*
*.p12
*.mobileprovision
